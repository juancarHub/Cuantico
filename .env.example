# ==================================================
# Atlantis Assistant - ejemplo de configuración
# Copia este fichero como .env y rellena tus claves reales.
# No subas nunca .env al repositorio.
# ==================================================

# --------------------------------------------------
# Identidad / persona
# --------------------------------------------------
ASSISTANT_NAME=Atlantis
SYSTEM_PROMPT_PATH=prompts/atlantis_system.txt

# --------------------------------------------------
# Debug / métricas
# --------------------------------------------------
DEBUG_LATENCY=true

# --------------------------------------------------
# Display / pantalla
# --------------------------------------------------
DISPLAY_BACKEND=screen
SCREEN_DISPLAY_MODE=window
# Opciones típicas:
# SCREEN_DISPLAY_MODE=window
# SCREEN_DISPLAY_MODE=tablet
# SCREEN_DISPLAY_MODE=fullscreen

# --------------------------------------------------
# Interacción de voz / tablet
# --------------------------------------------------
INPUT_MODE=push_to_talk
PUSH_TO_TALK_MODE=tap_or_silence
PUSH_TO_TALK_MAX_MS=12000
AUTO_STOP_SILENCE_MS=1800
AUTO_STOP_MIN_VOICE_MS=600
AUTO_STOP_RMS_THRESHOLD=500

# --------------------------------------------------
# LLM
# --------------------------------------------------
LLM_PROVIDER=openai
ENABLE_LLM_STREAMING=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini opcional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --------------------------------------------------
# STT / transcripción
# --------------------------------------------------
STT_PROVIDER=openai
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=es

# Deepgram opcional
DEEPGRAM_API_KEY=

# Wake word opcional
WAKE_MODEL_PATH=

# --------------------------------------------------
# TTS / voz
# --------------------------------------------------
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=1.0
OPENAI_TTS_FORMAT=mp3

# ElevenLabs opcional
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --------------------------------------------------
# Salida de audio
# --------------------------------------------------
AUDIO_OUTPUT_BACKEND=auto
# Opciones típicas:
# AUDIO_OUTPUT_BACKEND=auto
# AUDIO_OUTPUT_BACKEND=playsound

# --------------------------------------------------
# Integraciones de casa / futuras capacidades
# Pueden quedar vacías si no se usan todavía.
# --------------------------------------------------
GOVEE_API_KEY=

# --------------------------------------------------
# Música / OAuth
# Pueden quedar vacías si no se usan todavía.
# --------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --------------------------------------------------
# Google / YouTube / Calendar
# --------------------------------------------------
GOOGLE_CLIENT_SECRETS_PATH=state/google_client.json
GOOGLE_TOKEN_PATH=state/google_token.json
YOUTUBE_CHANNEL_ID=