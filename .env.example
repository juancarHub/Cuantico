# ==================================================
# Atlantis Assistant - 
# 
# No subas nunca .env al repositorio.
# ==================================================

#***************************************************
#**		SERVIDOR 		         ***	
#***************************************************
CUANTICO_SERVER_HOST=0.0.0.0
CUANTICO_SERVER_PORT=8000
CUANTICO_SERVER_EMBEDDED=true
CUANTICO_API_TOKEN=
CUANTICO_NODE_TOKENS=



# --------------------------------------------------
# Identidad / persona
# --------------------------------------------------
ASSISTANT_NAME=Cuantico
SYSTEM_PROMPT_PATH=prompts/atlantis_system.txt

# --------------------------------------------------
# Debug / métricas
# --------------------------------------------------
DEBUG_LATENCY=true

# --------------------------------------------------
# Display / pantalla
# --------------------------------------------------
DISPLAY_BACKEND=screen
SCREEN_DISPLAY_MODE=window
     # Opciones típicas:
	# SCREEN_DISPLAY_MODE=window
	# SCREEN_DISPLAY_MODE=tablet
	# SCREEN_DISPLAY_MODE=fullscreen

# --------------------------------------------------
# Interacción de voz / tablet
# --------------------------------------------------
INPUT_MODE=push_to_talk
	#INPUT_MODE=text

PUSH_TO_TALK_MODE=tap_or_silence
	#PUSH_TO_TALK_MODE=enter_stop
	#PUSH_TO_TALK_MODE=tap_stop

PUSH_TO_TALK_MAX_MS=12000    # 12 seg.
AUTO_STOP_SILENCE_MS=3500    # Tiempo silencio continuo para enviar el audio(3.5 Seg)
AUTO_STOP_MIN_VOICE_MS=600   # Cantidad mínima de voz detectada antes de permitir auto-corte.
AUTO_STOP_RMS_THRESHOLD=500  # Sensibilidad del detector de voz. RMS = volumen medio del audio./más bajo  = más sensible




# --------------------------------------------------
# LLM
# --------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

#*******************************************
# Gemini opcional
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview








# -----------------------------------------------------#
#         STT / transcripción (Voz a Texto) Entrada <- #
# -----------------------------------------------------#
STT_PROVIDER=openai
	OPENAI_STT_MODEL=gpt-4o-mini-transcribe
	OPENAI_STT_LANGUAGE=es

#************************************

#STT_PROVIDER=deepgram
#DEEPGRAM_API_KEY=3
# https://console.deepgram.com  → API Keys (free tier sobra)

#*************************************
# USO EN LOCAL:
# https://github.com/dscripka/openWakeWord o usa uno de los pre-entrenados.
# Ejemplo Pi:  /home/pi/Cuantico/cuantico.onnx
# Ejemplo Mac: /Users/tu_usuario/Cuantico/cuantico.onnx
# WAKE_MODEL_PATH=

# ------------------------------------------------------#
# 	   TTS / voz (Texto a Voz)    Salida ->         #
# ------------------------------------------------------#
#TTS_PROVIDER=openai
    OPENAI_TTS_MODEL=gpt-4o-mini-tts
    OPENAI_TTS_VOICE=marin
    #alloy -> male
    #nova ->Fem OK
    #marin -> Fem Gusta
    #fable -male

#**************************************************
# https://elevenlabs.io  →  Profile → API Keys
TTS_PROVIDER=elevenlabs
    ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
    #JBFqnCBsd6RMkjVDRZzb
    #nPczCjzI2devNBz1zQrb
    ELEVENLABS_API_KEY=
    # Voice ID por defecto (puedes clonar la tuya en ElevenLabs y pegar aquí su ID)

# --------------------------------------------------
# 		Salida de audio
# --------------------------------------------------
AUDIO_OUTPUT_BACKEND=windows
# Opciones típicas:
#    AUDIO_OUTPUT_BACKEND=file
#    AUDIO_OUTPUT_BACKEND=auto
#    AUDIO_OUTPUT_BACKEND=playsound
#    AUDIO_OUTPUT_BACKEND=linux





# --------------------------------------------------
# Música / OAuth
# Pueden quedar vacías si no se usan todavía.
# --------------------------------------------------
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ------- Música: Spotify -------
# https://developer.spotify.com/dashboard  → Create app
# Añade http://127.0.0.1:8888/callback como Redirect URI en la app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback



# --------------------------------------------------
# Google / YouTube / Calendar
# --------------------------------------------------
#GOOGLE_CLIENT_SECRETS_PATH=state/google_client.json
#GOOGLE_TOKEN_PATH=state/google_token.json
#YOUTUBE_CHANNEL_ID=

# ------- Google OAuth (Calendar + YouTube comparten Client ID tipo Desktop) -------
# 1. Console: https://console.cloud.google.com/apis/credentials
# 2. Create credentials → OAuth client ID → Desktop app
# 3. Descarga el JSON y guárdalo como state/google_client.json
# 4. La primera ejecución abrirá el navegador y generará state/google_token.json

# GOOGLE_CLIENT_SECRETS_PATH=state/google_client.json
# GOOGLE_TOKEN_PATH=state/google_token.json
# Vacío = usa el canal del usuario autenticado
# YOUTUBE_CHANNEL_ID=



# ------- Casa: luces Govee -------
# https://developer.govee.com  → solicitar key (llega por email)
GOVEE_API_KEY=



